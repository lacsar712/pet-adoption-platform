# Pet Adoption Platform — staging environment example.
#
# Copy this file to .ci/config/env.staging and replace the fake values with
# real staging secrets. The .staging file is git-ignored; only this example
# is committed. DO NOT put real credentials here.
#
# These variables feed `docker compose --env-file .ci/config/env.staging`
# interpolation. The base docker-compose.yml maps them onto the backend
# container's runtime environment (e.g. PET_JWT_SECRET -> JWT_SECRET).

# --- Pipeline / compose identity -------------------------------------------
PET_APP_ENV=staging
PET_COMPOSE_PROJECT_NAME=pet-adoption-staging

# --- Host-published ports (defaults match the demo convention) --------------
PET_API_PUBLISH_PORT=8731
PET_WEB_PUBLISH_PORT=3731
PET_DB_PUBLISH_PORT=5731

# --- Frontend build-time API URL -------------------------------------------
# Staging uses an ABSOLUTE URL (cross-origin), unlike demo's "/api".
PET_VITE_API_URL=http://localhost:8731

# --- Backend runtime configuration -----------------------------------------
# These are FAKE example values — replace them for a real staging deployment.
PET_JWT_SECRET=fake-staging-jwt-secret-replace-me
PET_MONGODB_URI=mongodb://db:27017/pet_adoption_staging
PET_SEED_DEMO=true
PET_UPLOAD_DIR=/app/uploads
NODE_ENV=production
