# ============================================================================
# env.staging.example —— staging 环境变量键名与示例值（全部为假数据！）
#
# 用法：复制为 .ci/config/env.staging.local 后按需替换示例值，
# 再以 --env-file 传给 docker compose（见 playbook「环境矩阵」一节）。
# 命名约定：全部大写蛇形（UPPER_SNAKE_CASE）。
# ============================================================================

# --- 第 1 轮定下的稳定变量名（compose 插值用） ---
PET_APP_ENV=staging
PET_COMPOSE_PROJECT_NAME=pet-adoption-staging
PET_API_PUBLISH_PORT=8731
PET_WEB_PUBLISH_PORT=3731
PET_DB_PUBLISH_PORT=5731
# staging 默认浏览器直连后端发布端口（与 demo 的 /api 反代不同，见 playbook）
PET_VITE_API_URL=http://localhost:8731

# --- staging 服务配置（docker-compose.staging.yml 中引用，示例值均为假数据） ---
JWT_SECRET=staging-fake-jwt-secret-do-not-use-in-prod
MONGODB_URI=mongodb://db:27017/pet_adoption_staging
SEED_DEMO=false
UPLOAD_DIR=/app/uploads
