# .ci/config/env.staging.example
# --------------------------------------------------------------------------
# Example environment for PET_APP_ENV=staging. Copy to a private, untracked
# file and replace the fake values before use (see ci-docker-playbook.md):
#
#   cp .ci/config/env.staging.example .env.staging.local
#   # edit .env.staging.local, then:
#   docker compose --env-file .env.staging.local \
#     -f docker-compose.yml -f docker-compose.staging.yml up -d --build
#
# ALL values below are FAKE placeholders. Do not use in production.
# --------------------------------------------------------------------------

# --- environment matrix ---------------------------------------------------
PET_APP_ENV=staging
PET_COMPOSE_PROJECT_NAME=pet-adoption-staging

# --- published host ports (project convention) ----------------------------
PET_API_PUBLISH_PORT=8731
PET_WEB_PUBLISH_PORT=3731
PET_DB_PUBLISH_PORT=5731

# --- frontend build-time API prefix (staging uses absolute origin) --------
PET_VITE_API_URL=http://localhost:8731

# --- backend application secrets / config (FAKE examples) -----------------
JWT_SECRET=staging-fake-jwt-secret-change-me-0000
MONGODB_URI=mongodb://db:27017/pet_adoption_staging
SEED_DEMO=true
UPLOAD_DIR=/app/uploads
NODE_ENV=production
PORT=8731
