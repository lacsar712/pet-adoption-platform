# .ci/config/env.staging.example
# Staging environment variables (EXAMPLE ONLY — all values here are fake).
#
# To create a local private staging env:
#   cp .ci/config/env.staging.example .ci/config/env.staging
#   # then edit .ci/config/env.staging and replace placeholder values.
#
# The rendered .ci/config/env.staging is git-ignored; never commit real
# secrets. Pass it to compose with --env-file:
#   docker compose --env-file .ci/config/env.staging \
#     -f docker-compose.yml -f docker-compose.staging.yml up -d --build

# --- Compose / pipeline selection ---
PET_APP_ENV=staging
PET_COMPOSE_PROJECT_NAME=pet-adoption-staging
PET_RELEASE_TAG=staging

# --- Published host ports (staging single-host) ---
PET_API_PUBLISH_PORT=8731
PET_WEB_PUBLISH_PORT=3731
PET_DB_PUBLISH_PORT=5731

# --- Frontend build-time API base URL ---
# Absolute URL because staging frontend may be opened directly from a browser
# without relying on the Nginx /api reverse proxy.
PET_VITE_API_URL=http://localhost:8731

# --- npm registry for image builds ---
NPM_REGISTRY=https://registry.npmmirror.com

# --- Backend application config (FAKE values, replace for real staging) ---
NODE_ENV=production
PORT=8731
MONGODB_URI=mongodb://db:27017/pet_adoption_staging
JWT_SECRET=staging-fake-jwt-secret-replace-me-0000
SEED_DEMO=false
UPLOAD_DIR=/app/uploads

# --- Healthcheck tuning (optional overrides) ---
# HEALTH_HOST=127.0.0.1
# HEALTH_PORT=8731
# HEALTH_PATH=/health
# HEALTH_RETRIES=10
# HEALTH_INTERVAL=2
# HEALTH_TIMEOUT=5
